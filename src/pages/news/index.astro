---
import fs from 'fs';
import path from 'path';
import HeaderWork from '../../components/HeaderWork.astro';
import Footer from '../../components/Footer.astro';
import Abtest from '../../components/Abtest.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const newsDir = path.resolve('./src/content/news');
const files = fs.readdirSync(newsDir).filter(f => f.endsWith('.md'));

// frontmatter を抽出して一覧用データを作る
let newsList = files.map(file => {
  const content = fs.readFileSync(path.join(newsDir, file), 'utf-8');
  const match = content.match(/^---\n([\s\S]+?)\n---/);
  let frontmatter = {};
  if (match) {
    const fmLines = match[1].split('\n');
    fmLines.forEach(line => {
      const [key, ...rest] = line.split(':');
      if (key && rest) frontmatter[key.trim()] = rest.join(':').trim().replace(/^"|"$/g,'');
    });
  }

  // 日付を分解
  const [year, month, day] = file.split('-').slice(0,3);

  return {
    slug: file.replace('.md',''),
    year,
    month,
    day,
    ...frontmatter
  };
});

// 🔹 新着順（date降順）にソート
newsList = newsList.sort((a, b) => new Date(b.date) - new Date(a.date));
---


